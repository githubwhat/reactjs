    "t5yie": {
      "rules": [
        { "if": { "any": [{ "m": "latest", "op": ">=", "v": 3.25 }, { "m": "latest", "op": "<", "v": 1.0 }] }, "risk": "danger", "reason": "5년 기대인플레이션 {latest}%가 연준 목표(2%)에서 크게 벗어났습니다." },
        { "if": { "any": [{ "m": "latest", "op": ">=", "v": 2.75 }, { "m": "latest", "op": "<", "v": 1.5 }] }, "risk": "caution", "reason": "5년 기대인플레이션 {latest}%가 목표(2%)에서 벗어나는 중입니다." }
      ],
      "default": { "risk": "normal", "reason": "5년 기대인플레이션 {latest}%로 안정 구간(1.5~2.75%)입니다." }
