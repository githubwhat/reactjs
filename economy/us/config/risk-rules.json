    "dfii10": {
      "rules": [
        { "if": { "m": "latest", "op": ">=", "v": 2.25 }, "risk": "caution", "reason": "10년 실질금리 {latest}%는 2008년 이후 높은 수준으로 자산가격에 부담입니다." }
      ],
      "default": { "risk": "normal", "reason": "10년 실질금리 {latest}%로 과도하게 긴축적인 수준은 아닙니다." }
