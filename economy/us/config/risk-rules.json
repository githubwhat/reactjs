        { "if": { "all": [{ "m": "min:250", "op": "<", "v": 0 }, { "m": "latest", "op": ">=", "v": 0 }] }, "risk": "caution", "reason": "최근 1년 내 역전됐다가 해소되었습니다. 역전 해소 국면은 과거 침체 시작 시점과 겹쳤습니다." },
        { "if": { "m": "latest", "op": "<", "v": 0.25 }, "risk": "caution", "reason": "금리차가 {latest}%p로 역전 직전입니다." }
      ],
      "default": { "risk": "normal", "reason": "금리차 {latest}%p로 정상 구간입니다." }
    },
    "dfii5": {
      "rules": [
        { "if": { "m": "latest", "op": ">=", "v": 2.25 }, "risk": "caution", "reason": "5년 실질금리 {latest}%는 2000년대 이후 높은 수준으로 긴축적인 금융여건입니다." }
      ],
      "default": { "risk": "normal", "reason": "5년 실질금리 {latest}%로 과도하게 긴축적인 수준은 아닙니다." }
