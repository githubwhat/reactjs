{
  "_doc": [
    "지표별 위험 깃발 규칙. rules는 위에서부터 검사하여 처음 맞는 규칙을 적용하고, 맞는 것이 없으면 default를 적용한다.",
    "규칙이 없는 지표는 '판단불가(⚪)'로 표시한다 — 정량 경계값이 뚜렷하지 않은 지표에 억지로 깃발을 붙이지 않기 위함.",
    "지표 m: latest | chg:N(N개 관측 전 대비 차이) | yoyPct(전년 대비 %) | yoyDiff(전년 대비 차이) | avg:N | min:N | max:N | sahm | riseFromLow:A:W(최근 A개 평균이 W개 구간의 A개 이동평균 최저치 대비 몇 % 높은지)",
    "조건: { m, op(< <= > >= ==), v(숫자) 또는 ref(다른 지표 id의 최신값) } / { any: [...] } / { all: [...] }",
    "reason의 {latest} {yoyPct} {yoyDiff} {sahm} 등은 계산값으로 치환된다. 위험 깃발은 거시경제 위험도이며 매매 추천이 아니다."
  ],
  "rules": {
    "sofr": {
      "rules": [
        { "if": { "m": "latest", "op": ">", "ref": "dfedtaru" }, "risk": "caution", "reason": "SOFR가 연준 목표범위 상단을 넘어 단기 자금시장 압박 신호입니다." }
      ],
      "default": { "risk": "normal", "reason": "SOFR가 연준 목표범위 안에서 움직이고 있습니다." }
    },
    "dff": {
      "rules": [
        { "if": { "m": "latest", "op": ">", "ref": "dfedtaru" }, "risk": "caution", "reason": "실효금리가 목표범위 상단을 넘어 자금시장 압박 신호입니다." }
      ],
      "default": { "risk": "normal", "reason": "실효금리가 목표범위 안에 있습니다. 금리 수준 자체는 위험 판단 대상이 아닙니다." }
    },
    "dgs2": {
      "rules": [
        { "if": { "m": "yoyDiff", "op": ">=", "v": 1.5 }, "risk": "danger", "reason": "1년 새 {yoyDiff}%p 급등해 금융여건이 빠르게 긴축되고 있습니다." },
        { "if": { "m": "yoyDiff", "op": ">=", "v": 1.0 }, "risk": "caution", "reason": "1년 새 {yoyDiff}%p 올라 금리 상승 압력이 큽니다." }
      ],
      "default": { "risk": "normal", "reason": "1년 변화 {yoyDiff}%p로 급격한 금리 상승은 없습니다." }
    },
    "dgs10": {
      "rules": [
        { "if": { "m": "yoyDiff", "op": ">=", "v": 1.5 }, "risk": "danger", "reason": "1년 새 {yoyDiff}%p 급등해 장기 조달비용이 빠르게 오르고 있습니다." },
        { "if": { "m": "yoyDiff", "op": ">=", "v": 1.0 }, "risk": "caution", "reason": "1년 새 {yoyDiff}%p 올라 장기금리 상승 압력이 큽니다." }
      ],
      "default": { "risk": "normal", "reason": "1년 변화 {yoyDiff}%p로 급격한 장기금리 상승은 없습니다." }
    },
    "dgs30": {
      "rules": [
        { "if": { "m": "yoyDiff", "op": ">=", "v": 1.5 }, "risk": "danger", "reason": "1년 새 {yoyDiff}%p 급등했습니다." },
        { "if": { "m": "yoyDiff", "op": ">=", "v": 1.0 }, "risk": "caution", "reason": "1년 새 {yoyDiff}%p 올랐습니다." }
      ],
      "default": { "risk": "normal", "reason": "1년 변화 {yoyDiff}%p로 급격한 상승은 없습니다." }
    },
    "t10y2y": {
      "rules": [
        { "if": { "m": "latest", "op": "<", "v": 0 }, "risk": "danger", "reason": "장단기 금리 역전({latest}%p) — 과거 경기침체에 앞서 자주 나타난 신호입니다." },
        { "if": { "all": [{ "m": "min:250", "op": "<", "v": 0 }, { "m": "latest", "op": ">=", "v": 0 }] }, "risk": "caution", "reason": "최근 1년 내 역전됐다가 다시 플러스로 돌아섰습니다. 과거엔 역전 해소 국면에서 침체가 시작되곤 했습니다." },
        { "if": { "m": "latest", "op": "<", "v": 0.25 }, "risk": "caution", "reason": "금리차가 {latest}%p로 역전 직전 수준까지 좁혀졌습니다." }
      ],
      "default": { "risk": "normal", "reason": "금리차 {latest}%p로 정상적인 우상향 수익률곡선입니다." }
    },
    "t10y3m": {
      "rules": [
